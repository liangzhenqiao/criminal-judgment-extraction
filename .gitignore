# local configuration and all data products stay out of version control
config.yaml
work/
*.parquet
*.csv.gz
*.jsonl
*.jsonl.gz
*.dta
*.xlsx
*.zip
__pycache__/
.pytest_cache/
.venv/
hf_cache/
*.log
.DS_Store

